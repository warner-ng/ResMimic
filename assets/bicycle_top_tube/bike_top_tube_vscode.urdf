      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
    <visual>
      <origin xyz="0.84811 0.08 0.267533" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/back_wheel_1.STL" scale="0.001 0.001 0.001"/>
